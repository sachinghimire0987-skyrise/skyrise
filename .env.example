# Copy this file to .env and fill in your own Supabase project credentials.
# Without these, the site runs fully in the UI using local demo data from
# src/data/ — see README.md > "Connecting Supabase".

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: used for canonical URLs / sitemap generation.
VITE_SITE_URL=https://sachinghimire.com
